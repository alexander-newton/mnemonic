# Backend Configuration
# Copy this file to .env and fill in actual values

# ========================================
# Application Settings
# ========================================

# Application environment (development, staging, production)
ENVIRONMENT=development

# Secret key for JWT token signing (use a strong random string)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Allow origins for CORS (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========================================
# Database Configuration
# ========================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://mnemonic:mnemonic@localhost:5432/mnemonic

# ========================================
# Cache Configuration
# ========================================

# Redis connection URL
# Format: redis://[:password]@host:port/db
REDIS_URL=redis://localhost:6379/0

# ========================================
# Authentication
# ========================================

# JWT token expiration time in minutes
JWT_EXPIRATION_MINUTES=30

# Password hashing algorithm rounds
PASSWORD_HASH_ROUNDS=12

# ========================================
# LLM Configuration (OpenRouter)
# ========================================

# OpenRouter API key (get from https://openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-api-key

# Default LLM model to use for variations
# Examples: openai/gpt-4, anthropic/claude-opus, meta-llama/llama-2-70b
DEFAULT_LLM_MODEL=openai/gpt-4

# OpenRouter API base URL (usually no need to change)
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# ========================================
# Logging
# ========================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable access logs
LOG_ACCESS=true

# ========================================
# Development Settings
# ========================================

# Enable auto-reload on file changes (development only)
DEBUG=true

# Enable verbose error messages
VERBOSE_ERRORS=true

# ========================================
# Card Rendering
# ========================================

# Path to Pandoc executable (if not in system PATH)
PANDOC_PATH=pandoc

# ========================================
# FSRS Algorithm
# ========================================

# Leech threshold (number of reviews before card is marked as leech)
LEECH_THRESHOLD=8

# ========================================
# Feature Flags
# ========================================

# Enable LLM-powered question variations
ENABLE_VARIATIONS=true

# Enable automatic leech detection
ENABLE_LEECH_DETECTION=true

# Enable card decomposition for leeches
ENABLE_DECOMPOSITION=true
